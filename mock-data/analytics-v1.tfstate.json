{
  "version": 4,
  "terraform_version": "1.6.0",
  "serial": 1,
  "lineage": "analytics-platform-001",
  "resources": [
    {
      "mode": "managed",
      "type": "aws_dynamodb_table",
      "name": "events",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "analytics-events-table",
            "name": "analytics-events-table",
            "billing_mode": "PAY_PER_REQUEST",
            "hash_key": "userId",
            "range_key": "timestamp",
            "attribute": [
              {
                "name": "userId",
                "type": "S"
              },
              {
                "name": "timestamp",
                "type": "N"
              }
            ],
            "tags": {
              "Name": "Analytics Events",
              "Project": "analytics-platform",
              "Environment": "production",
              "DataType": "events"
            }
          },
          "dependencies": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_lambda_function",
      "name": "processor",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "analytics-event-processor",
            "function_name": "analytics-event-processor",
            "runtime": "python3.11",
            "handler": "lambda_function.lambda_handler",
            "memory_size": 512,
            "timeout": 60,
            "role": "arn:aws:iam::123456789012:role/lambda-execution-role",
            "environment": {
              "variables": {
                "TABLE_NAME": "analytics-events-table",
                "REGION": "us-east-1"
              }
            },
            "tags": {
              "Name": "Event Processor",
              "Project": "analytics-platform",
              "Environment": "production",
              "Function": "data-processing"
            }
          },
          "dependencies": ["aws_dynamodb_table.events"]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_api_gateway_rest_api",
      "name": "analytics_api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "api-gateway-analytics",
            "name": "analytics-api",
            "description": "Analytics API Gateway",
            "endpoint_configuration": {
              "types": ["REGIONAL"]
            },
            "tags": {
              "Name": "Analytics API",
              "Project": "analytics-platform",
              "Environment": "production"
            }
          },
          "dependencies": ["aws_lambda_function.processor"]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "data_lake",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "analytics-data-lake-prod",
            "bucket": "analytics-data-lake-prod",
            "region": "us-east-1",
            "versioning": {
              "enabled": false
            },
            "lifecycle_rule": [
              {
                "enabled": true,
                "transition": [
                  {
                    "days": 90,
                    "storage_class": "GLACIER"
                  }
                ]
              }
            ],
            "tags": {
              "Name": "Data Lake",
              "Project": "analytics-platform",
              "Environment": "production",
              "Purpose": "long-term-storage"
            }
          },
          "dependencies": []
        }
      ]
    }
  ]
}

